# Cloudflare Pages — règles de cache.
# sw.js et index.html doivent TOUJOURS être revérifiés sur le réseau : ce sont eux qui décident si une
# nouvelle version de l'app est disponible. Sans ça, Cloudflare (ou le navigateur) peut continuer à servir
# une très vieille copie en cache indéfiniment, même après un nouveau déploiement (c'est ce qui causait le
# blocage sur d'anciennes versions malgré des pushs GitHub réussis).
#
# ➕ CORRIGÉ : "no-store" (en plus de "no-cache") interdisait TOUTE mise en cache, même conditionnelle —
# donc le fichier complet (index.html, ~700 Ko) devait être re-téléchargé EN ENTIER à chaque ouverture de
# l'app, même quand rien n'avait changé. Sur cellulaire, ça se traduisait par une lenteur marquée à
# l'ouverture. "no-cache" seul suffit à garantir la fraîcheur : le navigateur revalide TOUJOURS auprès du
# serveur avant d'utiliser sa copie, mais si rien n'a changé, Cloudflare répond 304 (quasi instantané, sans
# retélécharger le fichier) au lieu de renvoyer les ~700 Ko à chaque fois.
/sw.js
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# sa-admin et sa-terrain : même règle que ci-dessus.
/admin.html
  Cache-Control: no-cache, must-revalidate

/terrain.html
  Cache-Control: no-cache, must-revalidate

# Anciennes adresses (prototypes retirés le 03/10) : redirection + désinstallation de l'ancien service worker.
/sa-terrain/*
  Cache-Control: no-cache, must-revalidate

/sa-admin/*
  Cache-Control: no-cache, must-revalidate

# Carnet de bord Salle Mécanique (QR) — section publique (QR collé en salle mécanique), cloisonnée du reste :
# la page ne peut charger que ses propres fichiers et ne peut parler qu'à Supabase (REST + Realtime) ; aucun
# script externe ni en ligne, pas d'intégration dans un autre site, pas d'indexation, pas de référent transmis.
/qr-carnet/*
  Cache-Control: no-cache, must-revalidate
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src https://ldqvdiaewvhnukuaxdmc.supabase.co wss://ldqvdiaewvhnukuaxdmc.supabase.co; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/src/services/*
  Cache-Control: no-cache, must-revalidate

# Documentation, sources et tests : publiés par Cloudflare (tout le dépôt l'est), mais jamais indexés.
/docs/*
  X-Robots-Tag: noindex, nofollow

/src/*
  X-Robots-Tag: noindex, nofollow

/tests/*
  X-Robots-Tag: noindex, nofollow
